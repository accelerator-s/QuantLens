FROM quantlens/hadoop:locked
ARG HIVE_VERSION=4.2.1
ARG HIVE_SHA256
ARG HBASE_VERSION=2.6.7
ARG HBASE_SHA512
RUN /opt/python/bin/python /opt/quantlens/install_archive.py https://downloads.apache.org/hive/hive-${HIVE_VERSION}/apache-hive-${HIVE_VERSION}-bin.tar.gz ${HIVE_SHA256} /opt/hive && \
    /opt/python/bin/python /opt/quantlens/install_archive.py https://downloads.apache.org/hbase/${HBASE_VERSION}/hbase-${HBASE_VERSION}-hadoop3-bin.tar.gz ${HBASE_SHA512} /opt/hbase && \
    rm -rf /opt/hive/jdbc /opt/hbase/lib/shaded-clients /opt/hbase/lib/client-facing-thirdparty && \
    rm -f /opt/hbase/lib/hadoop-*.jar
RUN curl -fSL --retry 3 https://repo.maven.apache.org/maven2/org/postgresql/postgresql/42.7.14/postgresql-42.7.14.jar -o /opt/hive/lib/postgresql.jar && \
    echo '73914527305a40cce504b0d3d90b23caf565136912d607ae8ae7c5895512332c  /opt/hive/lib/postgresql.jar' | sha256sum -c -
COPY docker/harden_java.py docker/java-dependencies.json /opt/quantlens/
RUN /opt/python/bin/python /opt/quantlens/harden_java.py hive
COPY --from=quantlens/netty:locked /hbase-shaded-netty.jar /opt/hbase/lib/hbase-shaded-netty-4.1.14.jar
ENV JAVA_HOME=/usr/lib/jvm/java-21 HIVE_HOME=/opt/hive HIVE_CONF_DIR=/etc/hive/conf HBASE_HOME=/opt/hbase HIVE_AUX_JARS_PATH=/opt/hbase/lib PATH=/opt/hive/bin:$PATH HADOOP_HEAPSIZE=1024
CMD ["bash", "/opt/quantlens/init/hive.sh"]
