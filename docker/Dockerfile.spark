FROM quantlens/base:locked
ARG SPARK_VERSION=4.0.5
ARG SPARK_SHA512
ARG HIVE_CLIENT_VERSION=4.0.1
ARG HIVE_CLIENT_SHA256
RUN /opt/python/bin/python /opt/quantlens/install_archive.py https://downloads.apache.org/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz ${SPARK_SHA512} /opt/spark && \
    /opt/python/bin/python /opt/quantlens/install_archive.py https://archive.apache.org/dist/hive/hive-${HIVE_CLIENT_VERSION}/apache-hive-${HIVE_CLIENT_VERSION}-bin.tar.gz ${HIVE_CLIENT_SHA256} /opt/hive && \
    rm -rf /opt/hive/jdbc /opt/spark/examples
COPY docker/harden_java.py docker/java-dependencies.json /opt/quantlens/
RUN /opt/python/bin/python /opt/quantlens/harden_java.py spark
ENV JAVA_HOME=/usr/lib/jvm/java-17 SPARK_HOME=/opt/spark SPARK_CONF_DIR=/etc/spark/conf HADOOP_CONF_DIR=/etc/hadoop/conf PYTHONPATH=/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.9-src.zip:/workspace/src:/workspace PATH=/opt/spark/bin:/opt/python/bin:$PATH
CMD ["sleep", "infinity"]
